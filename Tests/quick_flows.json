  {
   "id": "hyperx-then-hypers-race",
   "from": "popup-stack-guard",
   "about": "Hyper+X followed immediately by Hyper+S (and rapid alternating Hyper+X / Hyper+S) dismisses the level-1000 overlay cleanly without hanging or trapping focus",
   "steps": [
    {
     "press": "hyper+x"
    },
    {
     "wait": 0.25
    },
    {
     "press": "hyper+s"
    },
    {
     "check": [
      {
       "state": "screenshotBusy",
       "equals": false
      },
      {
       "state": "live.palette.shown",
       "equals": true
      }
     ],
     "name": "Hyper+S dismissed Hyper+X overlay cleanly",
     "settle": 0.4
    },
    {
     "type": "pretty"
    },
    {
     "check": [
      {
       "state": "live.palette.query",
       "equals": "pretty"
