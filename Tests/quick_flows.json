    },
    {
     "key": "return"
    },
    {
     "wait": 1.2
    },
    {
     "key": "cmd+shift+g"
    },
    {
     "wait": 0.6
    },
    {
     "type": "~/qf"
    },
    {
     "key": "return"
    },
    {
     "wait": 1.0
    },
    {
     "check": [
      {
       "state": "live.files.cwd",
       "contains": "/qf"
      },
      {
       "state": "live.files.pane",
       "equals": "files-list"
      }
     ],
     "name": "Cmd+Shift+G jump: on ~/qf, the list has the keys"
    },
    {
