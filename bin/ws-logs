#!/usr/bin/env bash
# ws-logs — the ONE inventory of every log/data file kitchen-sink and its
# Python helpers can produce: the Jira poller/API, Confluence, notifications,
# the launch/focus bridge, the daemon and the app's own caches.
#
# It is the single source of truth for the health-checks `== logs ==` section
# (jira/jira-doctor.sh calls it with --no-header) and runs standalone:
#
#   bin/ws-logs [--group NAME] [--no-header] [--no-color] [--json]
#
# Paths are read from the files that define them — install.conf (CACHE_DIRS /
# RUNTIME_FILES), pylib/paths.json (the Jira cache names the poller and the app
# share), commands.toml `[app]` (crash-log, aero-log, notes-socket, …) and the
# product cache dirs — never a second, retyped list.
#
# A missing file is the normal case (nothing has written it yet): every path is
# reported, none is a failure, and the exit code is 0.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
HOME="${HOME:-$(cd ~ && pwd)}"
TMP="${TMPDIR:-/tmp}"; TMP="${TMP%/}"

# install.conf defines CACHE_DIRS + RUNTIME_FILES ($HOME/${TMPDIR} already
# expanded by the shell at source time) — the app's declared runtime paths.
# shellcheck source=/dev/null
[ -f "$ROOT/install.conf" ] && . "$ROOT/install.conf"

COLOR=1; NOHEAD=0; JSON=0; GROUP=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --no-color)  COLOR=0 ;;
        --no-header) NOHEAD=1 ;;
        --json)      JSON=1 ;;
        --group)     GROUP="${2:-}"; shift ;;
        -h|--help)   sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    esac
    shift
done

# ------------------------------------------------------------------ helpers

# $HOME -> ~, $TMPDIR -> $TMPDIR (both are shell-expandable in a paste).
# A literal ~ variable keeps bash from tilde-expanding the replacement back
# to $HOME; tr squeezes the `$TMPDIR//name` double slash install.conf yields.
pretty() {
    local p="$1" tilde='~'
    p="${p/#$HOME/$tilde}"
    p="${p/#$TMP/\$TMPDIR}"
    printf '%s' "$p" | tr -s '/'
}

human() {
    awk -v n="${1:-0}" 'BEGIN{
        split("B K M G T", u, " ")
        i = 1
        while (n >= 1024 && i < 5) { n /= 1024; i++ }
        if (i == 1) printf "%dB", n; else printf "%.1f%s", n, u[i]
    }'
}

# bytes of a file, or of every file under a directory (0 when absent).
size_of() {
    local p="$1"
    if [ -d "$p" ]; then
        find "$p" -type f -exec stat -f '%z' {} + 2>/dev/null | awk '{s+=$1} END{print s+0}'
    elif [ -e "$p" ]; then
        stat -f '%z' "$p" 2>/dev/null || echo 0
    else
        echo 0
    fi
}

mtime_of() { stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$1" 2>/dev/null; }
n_entries() { ls -A "$1" 2>/dev/null | wc -l | tr -d ' '; }

# ---------------------------------------------------------------- printing

ROWS=()
curgroup=""

badge() {
    case "$1" in
        ok)  [ "$COLOR" = 1 ] && printf '\033[32m[ok]\033[0m' || printf '[ok]' ;;
        --)  [ "$COLOR" = 1 ] && printf '\033[2m[--]\033[0m' || printf '[--]' ;;
        *)   [ "$COLOR" = 1 ] && printf '\033[2m[n/a]\033[0m' || printf '[n/a]' ;;
    esac
}

group() {
    curgroup="$1"
    [ "$JSON" = 1 ] && return
    [ -n "$GROUP" ] && [ "$GROUP" != "$1" ] && return
    if [ "$COLOR" = 1 ]; then
        printf '\n  \033[1m%s\033[0m\n' "$2"
    else
        printf '\n  %s\n' "$2"
    fi
}

# emit GROUP PATH KIND EXISTS SIZE MTIME READ NOTE SOURCE
emit() {
    local g="$1" path="$2" kind="$3" exists="$4" size="$5" mt="$6" rd="$7" note="$8" src="$9"
    [ -n "$GROUP" ] && [ "$GROUP" != "$g" ] && return
    if [ "$JSON" = 1 ]; then
        ROWS+=("$(jq -cn --arg group "$g" --arg path "$path" --arg kind "$kind" \
            --argjson exists "$exists" --arg size "$size" --arg mtime "$mt" \
            --arg read "$rd" --arg note "$note" --arg source "$src" \
            '{group:$group,path:$path,kind:$kind,exists:$exists,size:$size,mtime:$mtime,read:$read,note:$note,source:$source}')")
        return
    fi
    local mark="ok" size1="$size" mt1="$mt"
    if [ "$kind" = "stream" ]; then
        mark="n/a"
    elif [ "$exists" != "true" ]; then
        mark="--"; size1="-"; mt1="-"
    fi
    local disp="$path"
    [ -n "$note" ] && disp="$path  ($note)"
    if [ "$COLOR" = 1 ]; then
        printf '  %s %6s  %16s  %s  \033[2m· %s\033[0m\n' "$(badge "$mark")" "$size1" "$mt1" "$disp" "$rd"
    else
        printf '  %s %6s  %16s  %s  · %s\n' "$(badge "$mark")" "$size1" "$mt1" "$disp" "$rd"
    fi
}

rowfile() { # PATH NOTE SOURCE [READ]
    local p="$1" note="${2:-}" src="${3:-}" rd="${4:-tail -f $(pretty "$1")}" st=false size="-" mt="-"
    if [ -e "$p" ]; then
        st=true; size="$(human "$(size_of "$p")")"; mt="$(mtime_of "$p")"
    fi
    emit "$curgroup" "$(pretty "$p")" file "$st" "$size" "$mt" "$rd" "$note" "$src"
}

rowglob() { # PATTERN NOTE SOURCE [READ]
    local pat="$1" note="${2:-}" src="${3:-}" rd="${4:-ls -t $(pretty "$1") | head}"
    local f n=0 total=0 newest="" mt="-"
    local files=()
    while IFS= read -r f; do files+=("$f"); done < <(compgen -G "$pat")
    n="${#files[@]}"
    if [ "$n" -gt 0 ]; then
        for f in "${files[@]}"; do total=$((total + $(size_of "$f"))); done
        newest="$(ls -t "${files[@]}" 2>/dev/null | head -1)"
        mt="$(mtime_of "$newest")"
        [ -n "$note" ] && note="$note, $n file(s)" || note="$n file(s)"
    fi
    emit "$curgroup" "$(pretty "$pat")" glob "$([ "$n" -gt 0 ] && echo true || echo false)" \
        "$([ "$n" -gt 0 ] && human "$total" || echo '-')" "$mt" "$rd" "$note" "$src"
}

rowdir() { # PATH NOTE SOURCE
    local p="$1" note="${2:-}" src="${3:-}" st=false size="-" mt="-"
    if [ -d "$p" ]; then
        st=true; size="$(human "$(size_of "$p")")"; mt="$(mtime_of "$p")"
        [ -n "$note" ] && note="$note, $(n_entries "$p") entries" || note="$(n_entries "$p") entries"
    fi
    emit "$curgroup" "$(pretty "$p")/" dir "$st" "$size" "$mt" "ls -t $(pretty "$p") | head" "$note" "$src"
}

rowstream() { # LABEL READ NOTE SOURCE
    emit "$curgroup" "$1" stream false "-" "-" "$2" "$3" "$4"
}

# ------------------------------------------------------------------ sources

# commands.toml `[app]` (crash-log, aero-log, debug-flag, notes-socket, …).
cfg_app() {
    awk -v want="$1" '
        /^\[/ { sec=$0; sub(/^\[/,"",sec); sub(/\]$/,"",sec); next }
        sec=="app" {
            line=$0; sub(/#.*/,"",line)
            p=index(line,"="); if (p==0) next
            k=substr(line,1,p-1); gsub(/^[ \t]+|[ \t]+$/,"",k)
            if (k!=want) next
            v=substr(line,p+1); gsub(/^[ \t]+|[ \t]+$/,"",v); gsub(/^"|"$/,"",v)
            print v; exit
        }' "$ROOT/commands.toml" 2>/dev/null
}
exp() { local p="$1"; printf '%s' "${p/#\~/$HOME}"; }

APP_CRASH="$(exp "$(cfg_app crash-log)")";   APP_CRASH="${APP_CRASH:-$HOME/.cache/ws-crash.log}"
APP_AERO="$(exp "$(cfg_app aero-log)")";     APP_AERO="${APP_AERO:-$HOME/.cache/ws-aero.log}"
APP_DEBUGFLAG="$(exp "$(cfg_app debug-flag)")"; APP_DEBUGFLAG="${APP_DEBUGFLAG:-$HOME/.cache/aero-debug}"
SOCK_NAME="$(cfg_app notes-socket)";   SOCK_NAME="${SOCK_NAME:-ws-notes.sock}"
FOCUS_NAME="$(cfg_app focus-file)";    FOCUS_NAME="${FOCUS_NAME:-kitchen-sink-focus}"
BRIDGE_NAME="$(cfg_app focus-bridge)"; BRIDGE_NAME="${BRIDGE_NAME:-ws-aerospace-focus}"
NOTES_SOCK="$TMP/$SOCK_NAME"
FOCUS_FILE="$TMP/$FOCUS_NAME"
FOCUS_BRIDGE="$TMP/$BRIDGE_NAME"

# pylib/paths.json — the Jira cache names the poller and the app share.
PATHS_JSON="$ROOT/pylib/paths.json"
jp() { jq -r "$1 // empty" "$PATHS_JSON" 2>/dev/null; }
jc() { local v; v="$(jq -r ".cache[\"$1\"] // empty" "$PATHS_JSON" 2>/dev/null)"; printf '%s' "${v:-$2}"; }
JR_CACHE="$(jp '.cacheDir')"; JR_CACHE="${JR_CACHE:-$HOME/.cache/jira}"; JR_CACHE="${JR_CACHE/#\~/$HOME}"
JR_OUT="$(jp '.outDir')";     JR_OUT="${JR_OUT:-$HOME/.cache/kitchen-sink/jira_json}"; JR_OUT="${JR_OUT/#\~/$HOME}"
JR_SIDE_ROOT="$(dirname "$JR_OUT")"
jsd() { jq -r ".sideDirs[\"$1\"] // empty" "$PATHS_JSON" 2>/dev/null; }
jt()  { jq -r ".tabs[\"$1\"] // empty" "$PATHS_JSON" 2>/dev/null; }

APP_CACHE="${CACHE_DIRS:-}"; APP_CACHE="${APP_CACHE%% *}"; APP_CACHE="${APP_CACHE:-$HOME/.cache/kitchen-sink}"
SETTINGS_CACHE="${WS_SETTINGS_CACHE:-$APP_CACHE}"
CONF_CACHE="${CONFLUENCE_CACHE_DIR:-$HOME/.cache/confluence}"
NOTIFY_CACHE="${NOTIFY_CACHE_DIR:-$HOME/.cache/notifications}"
SANDBOX="${KS_MCP_SANDBOX:-$ROOT/.build/mcp-sandbox}"

# ------------------------------------------------------------------ header

if [ "$JSON" != 1 ] && [ "$NOHEAD" != 1 ]; then
    if [ "$COLOR" = 1 ]; then printf '\033[1;36m== logs ==\033[0m\n'; else printf '== logs ==\n'; fi
    printf '           every log/data file kitchen-sink can write — size + mtime, and how to read it\n'
    printf '           (missing = nothing has written it yet; that is not an error)\n'
fi

# ------------------------------------------------------- app cache / runtime

group app "kitchen-sink app cache — ~/.cache/kitchen-sink"
rowglob "$APP_CACHE/config-*.json" "commands.toml decode cache" "engines/config_text.rs"
rowfile "$APP_CACHE/screenshot-state.json" "screenshot panel state" "views/screenshot.rs"
rowdir  "$APP_CACHE/screenshots" "screenshot history ([screenshot] history)" "views/screenshot.rs"
rowfile "$APP_CACHE/paths.json" "PathShelf store" "engines/path_shelf.rs"
rowfile "$APP_CACHE/recent.json" "recent files" "views/files.rs"
rowfile "$APP_CACHE/files-favorites.json" "files pane favorites" "views/files.rs"
rowfile "$APP_CACHE/compare-recent.json" "compare recent pairs" "views/compare.rs"
rowdir  "$APP_CACHE/compare-pasted" "compare pasted-text store" "views/compare.rs"
rowdir  "$APP_CACHE/prose" "prose pane rendered pages" "views/notes_prose.rs"
rowfile "$SETTINGS_CACHE/settings-hub.log" "settings hub log" "settings_hub/tui/app.py"

group runtime "runtime + launch bridge (\$TMPDIR · ~/.cache)"
rowfile "$NOTES_SOCK" "daemon socket ([app] notes-socket)" "commands.toml [app]"
rowfile "$FOCUS_FILE" "focused-window handover ([app] focus-file)" "commands.toml [app]"
rowfile "$FOCUS_BRIDGE" "AeroSpace focus bridge ([app] focus-bridge)" "commands.toml [app]"
rowfile "$APP_CRASH" "crash log ([app] crash-log; writer may be absent)" "commands.toml [app]"
rowfile "$APP_AERO" "AeroSpace bridge log ([app] aero-log)" "commands.toml [app]"
rowfile "$APP_DEBUGFLAG" "AeroSpace debug flag ([app] debug-flag)" "commands.toml [app]"
# install.conf RUNTIME_FILES: add the declared paths not already covered above.
covered=" $SOCK_NAME $FOCUS_NAME $BRIDGE_NAME $(basename "$APP_CRASH") $(basename "$APP_AERO") $(basename "$APP_DEBUGFLAG") "
for f in ${RUNTIME_FILES:-}; do
    bn="${f##*/}"
    case " $covered " in *" $bn "*) continue ;; esac
    note="declared runtime file"
    case "$bn" in
        ws-launch.log)    note="launch trace (only with WS_DEBUG=1)" ;;
        ws-debug.log)     note="declared runtime file (writer may be absent)" ;;
        ws-auth.log|ws-auth-debug|ws-voice-debug.log) note="declared runtime file (writer may be absent)" ;;
    esac
    rowfile "$f" "$note" "install.conf RUNTIME_FILES"
done

# -------------------------------------------------------------------- daemon

group daemon "daemon"
rowstream "daemon stderr (no file — the unified log)" \
    "log stream --predicate 'process == \"kitchen-sink\"'" \
    "eprintln! in main.rs; launched via 'open', so stderr lands in the unified log" \
    "rust/ws-rs/src/main.rs"
rowfile "$SANDBOX/daemon.log" "sandbox daemon stdout/stderr" "bin/ks-mcp-sandbox.sh"

# ---------------------------------------------------------------------- jira

group jira "jira poller / API — $(pretty "$JR_CACHE")  (pylib/paths.json)"
rowfile "$JR_CACHE/$(jc pollLog poll.log)"        "short poll summary (truncated past 2MB)" "paths.json cache.pollLog"
rowglob "$JR_CACHE/$(jc debugLog debug.log)*"     "full debug log (rotates .1…5)" "paths.json cache.debugLog" "tail -f $(pretty "$JR_CACHE/$(jc debugLog debug.log)")"
rowfile "$JR_CACHE/$(jc curlLog curl.log)"        "every curl request — HOLDS THE REAL TOKEN, chmod 600" "paths.json cache.curlLog"
rowfile "$JR_CACHE/$(jc curlDump api_dump.txt)"   "curl per endpoint (--verbose, masked)" "paths.json cache.curlDump"
rowfile "$JR_CACHE/$(jc trace api_trace.txt)"     "timestamped request trace (--verbose)" "paths.json cache.trace"
rowfile "$JR_CACHE/$(jc status status.json)"      "poller status / lock holder / per-endpoint" "paths.json cache.status"
rowfile "$JR_CACHE/$(jc issues jiras.json)"       "issue cache (the jira window reads it)" "paths.json cache.issues"
rowfile "$JR_CACHE/$(jc directory directory.json)" "projects/users/statuses/fields pickers" "paths.json cache.directory"
rowfile "$JR_CACHE/$(jc boardCatalog board_catalog.json)" "board catalog" "paths.json cache.boardCatalog"
rowfile "$JR_CACHE/$(jc boards boards.json)"      "boards" "paths.json cache.boards"
rowfile "$JR_CACHE/$(jc sprints sprints.json)"    "sprints" "paths.json cache.sprints"
rowfile "$JR_CACHE/$(jc me me.json)"              "the /myself user" "paths.json cache.me"
rowfile "$JR_CACHE/$(jc fieldsSeen fields_seen.json)" "seen fields" "paths.json cache.fieldsSeen"
rowfile "$JR_CACHE/$(jc versions versions.json)"  "release versions" "paths.json cache.versions"
rowfile "$JR_CACHE/$(jc legacyPollState poll-state)" "legacy LAST_POLL marker" "paths.json cache.legacyPollState"
rowfile "$JR_CACHE/$(jc state state)"             "sync resume state" "paths.json cache.state"
rowfile "$JR_CACHE/$(jc tz tz)"                   "the user's timeZone" "paths.json cache.tz"
rowfile "$JR_CACHE/$(jc pageCap search_page_cap.json)" "search page-size cap per site" "paths.json cache.pageCap"
rowglob "$JR_CACHE/*.lock"                        "flock files (poll.lock, status.lock)" "jira_status.py / jira_poll.py"
rowdir  "$JR_CACHE/$(jc raw raw)"                 "every response body + meta (chmod 700)" "jira_log.RawStore"
rowdir  "$JR_CACHE/$(jc checkpoints checkpoints)" "streamed sync resume points" "paths.json cache.checkpoints"
rowdir  "$JR_CACHE/$(jc dumps dumps)"             "issue snapshots" "jira_api.py --sync"
rowdir  "$JR_CACHE/$(jc keysDir endpoints)"       "per-endpoint issue-key sets (keys_file)" "paths.json cache.keysDir"

group jira-window "jira window + board cache — $(pretty "$JR_SIDE_ROOT")"
rowdir  "$JR_OUT" "jira window tab files" "jira_poll.py (outDir)"
rowfile "$JR_OUT/$(jt liveSearch)"       "live search tab" "paths.json tabs.liveSearch"
rowfile "$JR_OUT/$(jt favorites)"        "favorites tab" "paths.json tabs.favorites"
rowfile "$JR_OUT/$(jt blacklistRelease)" "release blacklist tab" "paths.json tabs.blacklistRelease"
rowdir  "$JR_SIDE_ROOT/$(jsd releases)"  "release-view tab issues" "paths.json sideDirs.releases"
rowdir  "$JR_SIDE_ROOT/$(jsd labels)"    "label-view tab issues" "paths.json sideDirs.labels"
rowdir  "$JR_SIDE_ROOT/$(jsd boards)"    "board-<id>.json cache" "paths.json sideDirs.boards"
rowdir  "$JR_SIDE_ROOT/$(jsd myWork)"    "My Work tab issues" "paths.json sideDirs.myWork"

# ------------------------------------------------------------------- launchd

group launchd "jira poll launchd agent (com.jira.poll)"
PLIST="$ROOT/jira/com.jira.poll.plist"
if [ -f "$PLIST" ]; then
    for key in StandardOutPath StandardErrorPath; do
        p="$(awk -v k="<key>$key</key>" '$0 ~ k { getline; gsub(/.*<string>|<\/string>.*/,""); print; exit }' "$PLIST")"
        [ -n "$p" ] && rowfile "$p" "launchd $key" "jira/com.jira.poll.plist"
    done
fi

# ---------------------------------------------------------------- confluence

group confluence "confluence — $(pretty "$CONF_CACHE")  (confluence_config.py)"
rowglob "$CONF_CACHE/debug.log*" "full debug log (rotates .1…5)" "jira_log.setup(cache_dir=…)" "tail -f $(pretty "$CONF_CACHE/debug.log")"
rowfile "$CONF_CACHE/curl.log"   "every curl request — HOLDS THE REAL TOKEN, chmod 600" "confluence_api.py"
rowdir  "$CONF_CACHE/raw"        "response bodies + meta" "jira_log.RawStore"
rowfile "$CONF_CACHE/users.json" "contributor picker people cache" "confluence_api.py --users"
rowfile "$CONF_CACHE/ratelimit.json" "rate-limit cooldown" "confluence_api.py"

# ------------------------------------------------------------- notifications

group notifications "notifications — $(pretty "$NOTIFY_CACHE")  (notify/notify_poll.py)"
rowfile "$NOTIFY_CACHE/poll.log"  "unread-count poll events" "notify/notify_poll.py"
rowfile "$NOTIFY_CACHE/state.json" "cached badge/API state" "notify/notify_poll.py"
rowfile "$NOTIFY_CACHE/poll.lock" "poll flock" "notify/notify_poll.py"

# -------------------------------------------------------------------- output

if [ "$JSON" = 1 ]; then
    if [ "${#ROWS[@]}" -gt 0 ]; then
        printf '%s\n' "${ROWS[@]}" | jq -s .
    else
        printf '[]\n'
    fi
fi
exit 0
