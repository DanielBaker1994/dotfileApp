#!/usr/bin/env bash
# ws-logs — inventory of log files in the unified logs/ directory
#
# All logs live in logs/YYYY_MM_DD/*.log (date-based rolling)
# Managed by pylib/log_hub.py
#
# Usage:
#   bin/ws-logs [--no-header] [--no-color]
#
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
HOME="${HOME:-$(cd ~ && pwd)}"

COLOR=1; NOHEAD=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --no-color)  COLOR=0 ;;
        --no-header) NOHEAD=1 ;;
        -h|--help)   sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    esac
    shift
done

# ------------------------------------------------------------------ helpers

pretty() {
    local p="$1" tilde='~'
    p="${p/#$HOME/$tilde}"
    printf '%s' "$p"
}

human() {
    awk -v n="${1:-0}" 'BEGIN{
        split("B K M G T", u, " ")
        i = 1
        while (n >= 1024 && i < 5) { n /= 1024; i++ }
        if (i == 1) printf "%dB", n; else printf "%.1f%s", n, u[i]
    }'
}

size_of() {
    local p="$1"
    if [ -d "$p" ]; then
        find "$p" -type f -exec stat -f '%z' {} + 2>/dev/null | awk '{s+=$1} END{print s+0}'
    elif [ -e "$p" ]; then
        stat -f '%z' "$p" 2>/dev/null || echo 0
    else
        echo 0
    fi
}

mtime_of() { stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$1" 2>/dev/null; }

# ---------------------------------------------------------------- printing

badge() {
    case "$1" in
        ok)  [ "$COLOR" = 1 ] && printf '\033[32m[ok]\033[0m' || printf '[ok]' ;;
        --)  [ "$COLOR" = 1 ] && printf '\033[2m[--]\033[0m' || printf '[--]' ;;
    esac
}

show_file() {
    local path="$1" note="$2"
    local exists=false size="-" mt="-"
    if [ -e "$path" ]; then
        exists=true; size="$(human "$(size_of "$path")")"; mt="$(mtime_of "$path")"
    fi
    local mark="ok" size1="$size" mt1="$mt"
    if [ "$exists" != "true" ]; then
        mark="--"; size1="-"; mt1="-"
    fi
    if [ "$COLOR" = 1 ]; then
        printf '  %s %6s  %16s  %s\n' "$(badge "$mark")" "$size1" "$mt1" "$(pretty "$path")"
    else
        printf '  %s %6s  %16s  %s\n' "$(badge "$mark")" "$size1" "$mt1" "$(pretty "$path")"
    fi
}

show_dir() {
    local path="$1" note="$2"
    local exists=false size="-" mt="-" count="-"
    if [ -d "$path" ]; then
        exists=true; size="$(human "$(size_of "$path")")"; mt="$(mtime_of "$path")"
        count="$(find "$path" -type f 2>/dev/null | wc -l | tr -d ' ') files"
    fi
    local mark="ok" size1="$size" mt1="$mt"
    if [ "$exists" != "true" ]; then
        mark="--"; size1="-"; mt1="-"; count="-"
    fi
    if [ "$COLOR" = 1 ]; then
        printf '  %s %6s  %16s  %s  (%s)\n' "$(badge "$mark")" "$size1" "$mt1" "$(pretty "$path")" "$count"
    else
        printf '  %s %6s  %16s  %s  (%s)\n' "$(badge "$mark")" "$size1" "$mt1" "$(pretty "$path")" "$count"
    fi
}

# ------------------------------------------------------------------ header

if [ "$NOHEAD" != 1 ]; then
    if [ "$COLOR" = 1 ]; then
        printf '\033[1;36m== logs ==\033[0m\n'
    else
        printf '== logs ==\n'
    fi
    printf '  all logs in logs/YYYY_MM_DD/*.log (date-based rolling)\n'
    printf '  managed by pylib/log_hub.py\n'
fi

# ------------------------------------------------------------------ logs

LOG_DIR="$ROOT/logs"
TODAY="$(date +%Y_%m_%d)"
TODAY_DIR="$LOG_DIR/$TODAY"

printf '\n'
if [ "$COLOR" = 1 ]; then
    printf '  \033[1mlog directory\033[0m\n'
else
    printf '  log directory\n'
fi

show_dir "$LOG_DIR" "all logs"

if [ -d "$TODAY_DIR" ]; then
    printf '\n'
    if [ "$COLOR" = 1 ]; then
        printf '  \033[1mtoday (%s)\033[0m\n' "$TODAY"
    else
        printf '  today (%s)\n' "$TODAY"
    fi
    
    # Show each log file in today's directory
    for logfile in "$TODAY_DIR"/*.log; do
        [ -f "$logfile" ] || continue
        basename="$(basename "$logfile")"
        show_file "$logfile" "$basename"
    done
fi

# Show recent days (excluding today)
if [ -d "$LOG_DIR" ]; then
    recent_days="$(ls -1 "$LOG_DIR" 2>/dev/null | grep -E '^[0-9]{4}_[0-9]{2}_[0-9]{2}$' | grep -v "^${TODAY}$" | sort -r | head -5)"
    if [ -n "$recent_days" ]; then
        printf '\n'
        if [ "$COLOR" = 1 ]; then
            printf '  \033[1mrecent days\033[0m\n'
        else
            printf '  recent days\n'
        fi
        while IFS= read -r day; do
            show_dir "$LOG_DIR/$day" "$day"
        done <<< "$recent_days"
    fi
fi

# ------------------------------------------------------------------ cleanup

# Clean up old orphaned logs from previous locations
cleanup_old_logs() {
    local old_paths=(
        "$HOME/.cache/ws-crash.log"
        "$HOME/.cache/ws-aero.log"
        "$HOME/.cache/aero-debug"
        "$HOME/.cache/ws-auth-debug"
        "$HOME/.cache/ws-auth.log"
        "$HOME/.cache/ws-voice-debug.log"
        "/tmp/ws-debug.log"
        "$TMPDIR/ws-launch.log"
        "$HOME/.cache/jira/poll.log"
        "$HOME/.cache/jira/debug.log"
        "$HOME/.cache/jira/curl.log"
        "$HOME/.cache/confluence/debug.log"
        "$HOME/.cache/confluence/curl.log"
        "$HOME/.cache/notifications/poll.log"
        "$HOME/.cache/kitchen-sink/settings-hub.log"
    )
    
    cleaned=0
    for old_path in "${old_paths[@]}"; do
        if [ -f "$old_path" ]; then
            rm -f "$old_path" 2>/dev/null && cleaned=$((cleaned + 1))
        fi
    done
    
    if [ "$cleaned" -gt 0 ]; then
        printf '\n'
        if [ "$COLOR" = 1 ]; then
            printf '  \033[33mcleaned %d old orphaned log file(s)\033[0m\n' "$cleaned"
        else
            printf '  cleaned %d old orphaned log file(s)\n' "$cleaned"
        fi
    fi
}

cleanup_old_logs

exit 0
