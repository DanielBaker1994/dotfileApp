  "api_endpoints": {
    "myself": "/myself",
    "search": "/search",
    "issue": "/issue/{key}",
    "projects": "/project",
    "project": "/project/{project}",
    "project_versions": "/project/{project}/versions",
    "statuses": "/status",
    "fields": "/field",
    "assignable_users": "/user/assignable/search",
