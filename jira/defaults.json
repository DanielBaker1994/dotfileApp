    "waiting": "status-waiting-words",
    "new": "status-new-words",
    "urgent": "priority-urgent-words"
  },
  "dim_fields": ["key", "updated", "created", "duedate", "releasedate",
                 "project", "releaselabel", "release"],
  "category_names": ["To Do", "In Progress", "Done"],
  "pages": {
    "hex_keys": ["bg", "card", "s0", "s1", "tx", "dim", "acc", "on", "ok", "warn"]
  },
  "boards": {
    "done_limit": 30,
    "other_column": "Not on the board",
    "color_keys": ["bg", "col", "card", "cardHover", "line", "text", "dim", "accent", "done", "hot"],
    "hot_words": ["highest", "high", "critical", "blocker"]
  },
  "directory": {
    "top_n": 50
  },
  "http": {
    "retry_codes": [429, 502, 503, 504],
    "transient_curl": [6, 7, 16, 18, 28, 35, 52, 55, 56, 92],
    "shrink_curl": [16, 18, 28, 52, 56, 92],
    "shrink_http": [500, 502, 503, 504],
    "min_page": 10,
    "page_cap_days": 7,
    "max_attempts": 8,
    "max_401_attempts": 5,
    "auth_401_backoff": 5,
    "max_401_in_row": 3,
    "backoff_cap": 60,
    "page_overlap": 5
  },
  "api": {
    "query_fields": "summary,status,assignee,fixVersions,description,updated,priority,labels"
  },
  "logging": {
    "curl_log_max": 5242880,
    "poll_log_max": 2097152,
    "debug_log_max": 10485760,
    "debug_log_backups": 5
  },
  "sprints": {
    "rank": {"active": 0, "future": 1, "closed": 2}
  },
  "my_work": {
    "views": [["mine", "Assigned to me"], ["reported", "Reported by me"], ["today", "Updated today"]],
    "watching": {
      "name": "mywork-watching",
      "type": "issues",
      "jql": "watcher = currentUser()",
      "file": "watching.json",
      "window": "15m",
      "projects": "*",
      "enabled": true
    }
  },
  "poll": {
    "error_retry": 300
  },
  "poll_defaults": {
    "window": "10m",
    "job_window": "15m",
    "filter_window": "30m",
    "page_size": 50
  },
  "search_ui": {
    "skip_fields": ["key", "title", "status", "assignee", "release", "releaseLabel",
                    "releaseDate", "releaseStatus", "priority", "labels", "description",
                    "reporter", "project", "updated", "comments"],
    "kinds": [
      {"key": "assignee", "title": "Assignee", "kind": "users", "labelField": "assignee"},
      {"key": "reporter", "title": "Reporter", "kind": "users", "labelField": "reporter"},
      {"key": "status", "title": "Status", "kind": "list", "labelField": "status"},
      {"key": "statusCategory", "title": "Status category", "kind": "list"},
      {"key": "issuetype", "title": "Issue type", "kind": "list"},
      {"key": "priority", "title": "Priority", "kind": "list", "labelField": "priority"},
      {"key": "fixVersion", "title": "Release", "kind": "list", "labelField": "release"},
      {"key": "labels", "title": "Labels", "kind": "list", "labelField": "labels"},
      {"key": "updated", "title": "Updated", "kind": "date", "labelField": "updated", "suffix": " within"},
      {"key": "created", "title": "Created", "kind": "date", "suffix": " within"},
      {"key": "resolved", "title": "Resolved", "kind": "date", "suffix": " within"},
      {"key": "field:title", "title": "Summary", "kind": "text", "labelField": "title", "suffix": " contains"},
      {"key": "field:description", "title": "Description", "kind": "text", "labelField": "description", "suffix": " contains"}
    ],
    "criteria": {
      "lists": {
        "projects": "project", "assignee": "assignee", "reporter": "reporter",
        "status": "status", "statusCategory": "statusCategory",
        "issuetype": "issuetype", "priority": "priority",
        "labels": "labels", "fixVersion": "fixVersion"
      },
      "dates": ["updated", "created", "resolved", "duedate"],
      "text_fields": {"title": "summary", "description": "description", "key": "issuekey",
                      "release": "fixVersion", "releaseLabel": "fixVersion",
                      "project": "project"}
    }
  }
}
