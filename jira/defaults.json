      "window": "1h",
      "projects": "*",
      "type": "releases",
      "file": "releases.json",
      "enabled": true
    },
    {
      "name": "favorites",
      "window": "10m",
      "projects": "*",
      "type": "favorites",
      "file": "favorites.json",
      "enabled": true
    },
    {
      "name": "directory",
      "window": "1w",
      "projects": "*",
      "type": "directory",
      "enabled": true
    }
