<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jira.poll</string>
    <!-- launchd ticks every 60s; jira_poll.py runs only the endpoints whose
         own window (config.json) has elapsed, so a tick is usually a no-op -->
    <key>ProgramArguments</key>
    <array>
        <!-- a wrapper, not python3 directly: it owns the date-based log
             rolling (logs/YYYY_MM_DD/jira-poll-{stdout,stderr}.log) because
             launchd's StandardOutPath cannot compute a date -->
        <string>__WS_CONFIG__/jira/jira_poll_launchd.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- an app install runs the script from inside the signed bundle:
             a __pycache__ written there would break its signature -->
        <key>PYTHONDONTWRITEBYTECODE</key>
        <string>1</string>
    </dict>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
