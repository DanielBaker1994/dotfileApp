  "narrative": {
    "northStar": "The Terminal Card",
    "overview": "kitchen-sink is a floating card that wears your terminal theme.\nSurfaces are stacked like a tmux or Catppuccin port, deepest first: the\nheader strip is the darkest band (crust), toolbars, tab strips and input\nwells sit one step in (mantle), the card is the base, and raised controls\nfloat just above it (surface). Nothing uses a system colour. Every pixel\ncomes from the active theme preset, so switching from Macchiato to Tokyo\nNight or Paper recolours every view, the embedded shell's ANSI palette and\nthe nvim pane together.\n\nThe look is dense and quiet. Text is small (10.5–13 pt), rows are 30 pt,\nand chrome is thin hairlines rather than boxes. Colour carries meaning, not\ndecoration. The one accent marks what is *selected or active*: the active\ntab, the cursor row's edge, an \"on\" toggle, a focus ring. The five palette\nhues (accent2, success, warning, danger, info) mark *state*: links and fuzzy\nmatches, Jira statuses, poll health, the ✕ hover. The card floats over a\nblurred desktop, so the system is translucent at the edges and solid where\nyou read.",
    "keyCharacteristics": [
      "Depth by tone, not shadow: crust < mantle < base < surface.",
      "One accent marks selection; palette hues mark status.",
      "Every colour is derived from the theme, with contrast lifted in code",
      "Small, dense, system-font UI; monospace only where text is edited.",
      "Thin hairlines (text at 8–12% opacity) separate regions; boxes are rare."
    ],
    "rules": [
      {
        "name": "The Theme-Only Rule",
        "body": "No `NSColor.systemX`, `controlAccentColor` or default selection colours. Draw with `PopupColors` tokens or a `tone(_:)`, because the machine's accent colour once made selections unreadable.",
        "section": "colors"
      },
      {
        "name": "The One Accent Rule",
        "body": "The accent means \"this is the selected or active one\". Status never borrows it; selection never borrows a status hue.",
        "section": "colors"
      },
      {
        "name": "The Contrast-in-Code Rule",
        "body": "A new themed colour goes through `readable`, `accentOn` or `onAccent`. Text drawn on a tint goes through `ensure(fg, on: over(tint, alpha, on: base))`, which measures it against the opaque colour it actually sits on: 4.5:1 for text, 3:1 for marks. It must survive all 29 presets, including Paper and Solarized Light.",
        "section": "colors"
      },
      {
        "name": "The Zoom Rule",
        "body": "Every size multiplies by `zoom` (Cmd+±). Never place a fixed point size in chrome without `* zoom`.",
        "section": "typography"
      },
      {
        "name": "The Weight-Marks-State Rule",
        "body": "Active means semibold plus accent, never a bigger size. Sizes stay on the scale above.",
        "section": "typography"
      },
      {
        "name": "The Recessed-Field Rule",
        "body": "Text inputs sink (mantle with a hairline) and buttons rise (a ghost fill). A field never looks like a button. Focus swaps the hairline for the accent.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw with `PopupColors` tokens and `tone(_:)`, and push live changes through `PopupThemeable` / `pushColors()`.",
      "Do layer surfaces crust < mantle < base < surface0/1, and keep inputs recessed and buttons raised.",
      "Do mark the cursor row with the highlight pill plus a 3 pt accent edge, and the active tab with the solid accent pill.",
      "Do scale every chrome size by `zoom`.",
      "Do check a new colour against light presets (Paper, Latte, Solarized Light) as well as dark ones."
    ],
    "donts": [
      "Don't use system colours, the macOS accent colour, or AppKit default selection and bezel styles.",
      "Don't use the accent for status, or a status hue for selection.",
      "Don't add shadows to elements inside the card. Depth there is tonal.",
      "Don't resize the shared window when switching views.",
      "Don't use capsule chips (the toast is the only pill) or corners above 4 pt on in-card controls."
    ]
  }
}