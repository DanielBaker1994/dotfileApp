{
  "markdown_custom": {
    "prefix": "markdown_css_header",
    "body": [
      "# Markdown Title Here",
      "",
      "Markdown Paragraph Here",
      "",
      "---",
      "",
      ""
    ]
  },
  "markdown_bash_block": {
    "prefix": "markdown_bash_block",
    "body": [
      "```bash",
      "echo ${HOME}",
      "```"
    ]
  },
  "markdown_python_block": {
    "prefix": "markdown_python_block",
    "body": [
      "```python",
      "if 5 > 2:",
      "    print(\"Five is greater than two!\")",
      "```"
    ]
  },
  "markdown_lua_block": {
    "prefix": "markdown_lua_block",
    "body": [
      "```lua",
      "local dirs = { vim.fn.stdpath('config') }",
      "for _, p in ipairs(parts) do",
      "    if p:match(\"%S\") then table.insert(dirs, p) end",
      "end",
      "return dirs",
      "```"
    ]
  },
  "markdown_cpp_block": {
    "prefix": "markdown_cpp_block",
    "body": [
      "```cpp",
      "#include <iostream>",
      "int main(){ std::cout << \"hello\"; }",
      "```"
    ]
  },
  "markdown_log_block": {
    "prefix": "markdown_log_block",
    "body": [
      "```log",
      "[WARN] example warning",
      "[ERROR] example error",
      "```"
    ]
  },
  "markdown_file_block": {
    "prefix": "markdown_file_block",
    "body": [
      "```{.file}",
      "/path/to/some/file.txt",
      "~/.config/markdown_generator/friendly_document_styling.css",
      "```"
    ]
  },
  "markdown_image_block": {
    "prefix": "markdown_image_block",
    "body": [
      "![](/path/to/image.png)"
    ]
  },
  "markdown_alert_note": {
    "prefix": "markdown_alert_note",
    "body": [
      "> [!NOTE]",
      "> $0"
    ]
  },
  "markdown_alert_tip": {
    "prefix": "markdown_alert_tip",
    "body": [
      "> [!TIP]",
      "> $0"
    ]
  },
  "markdown_alert_important": {
    "prefix": "markdown_alert_important",
    "body": [
      "> [!IMPORTANT]",
      "> $0"
    ]
  },
  "markdown_alert_warning": {
    "prefix": "markdown_alert_warning",
    "body": [
      "> [!WARNING]",
      "> $0"
    ]
  },
  "markdown_alert_caution": {
    "prefix": "markdown_alert_caution",
    "body": [
      "> [!CAUTION]",
      "> $0"
    ]
  }
}
