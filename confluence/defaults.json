{
  "types": [
    "page",
    "blogpost",
    "attachment",
    "comment"
  ],
  "modes": [
    "all",
    "phrase",
    "any"
  ],
  "modified": {
    "": null,
    "any": null,
    "7d": "-7d",
    "30d": "-30d",
    "90d": "-90d",
    "1y": "-1y"
  },
  "defaults": {
    "site": "",
    "auth": "",
    "email": "",
    "token": "",
    "spaces": [],
    "favorites": [],
    "search": {
      "limit": 25,
      "types": [
        "page",
        "blogpost"
      ],
      "sort": "relevance"
    },
    "timeoutSeconds": 20,
    "rateLimitMaxWaitSeconds": 20,
    "rateLimitMinSeconds": 3,
    "rateLimitFallbackSeconds": 30,
    "cooldownSeconds": 60,
    "requestDelayMs": 0,
    "usersMaxAgeHours": 24,
    "usersScanItems": 1000,
    "usersScanDelayMs": 300,
    "logLevel": "INFO",
    "rawCapture": false,
    "rawKeepDays": 1,
    "rawMaxMB": 200
  },
  "api": {
    "favorite_keys": ["id", "title", "space", "spaceName", "type", "url", "path"],
    "search_expand": "content.space,content.version,content.ancestors,content.container"
  },
  "pages": {
    "color_keys": ["light", "text", "text92", "dim", "accent", "mantle", "hairline",
                   "warn", "warn35", "warn75", "info"]
  }
}
