# built artifacts
kitchen-sink.app/
.build/
.agents/

# logs (date-based rolling)
logs/

# Linux cross-check (bin/linux-check.sh) cargo target (also covered by .build/)
.build/linux-target/

# Linux dist layout (bin/build-linux.sh -> dist/kitchen-sink/)
/dist/

# SwiftTerm (embedded terminal) is fetched at build time by
# bin/ensure-swiftterm.sh into install.conf SWIFTTERM_DIR (../SwiftTerm, outside
# this repo) — these catch a stray in-repo checkout so it can never be committed
Vendor/SwiftTerm/
Vendor/.swiftterm.tmp.*

# generated docs
README.html
README.pdf


PRD-screenshot.html
PRD-screenshot.pdf

# test-run screenshots (large; findings cite them by path, reports are committed)
Tests/usability/**/shots/

# junk
.DS_Store
*.log
__pycache__/
create_a_file_here.txt

# commands.toml safety copies (last-known-good + parked invalid edits)
commands.toml.bak
commands.toml.broken-*

# which install owns ~/.config/kitchen-sink (bin/setup-home.sh)
.install

# ws-settings ★ favorites (user data; the home is this checkout in repo mode)
settings-hub.json
