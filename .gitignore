# built artifacts
workspace-switcher.app/
.build/
.agents/

# SwiftTerm (embedded terminal) is fetched at build time by
# bin/ensure-swiftterm.sh into install.conf SWIFTTERM_DIR (../SwiftTerm, outside
# this repo) — these catch a stray in-repo checkout so it can never be committed
Vendor/SwiftTerm/
Vendor/.swiftterm.tmp.*

# generated docs
README.html
README.pdf

# junk
.DS_Store
*.log
__pycache__/
create_a_file_here.txt
testbackups/

# commands.toml safety copies (last-known-good + parked invalid edits)
commands.toml.bak
commands.toml.broken-*
