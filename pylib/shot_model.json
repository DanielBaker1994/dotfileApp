{
  "modes": ["gui", "text", "full", "screen"],
  "filename": {"pattern": "%F_%H-%M", "fallback": "screenshot"},
  "args": {"mode": "gui", "delayMs": 0},
  "state": {"gridSize": 10},
  "default_buttons": "pencil, line, arrow, selection, rectangle, circle, marker, text, counter, pixelate, invert, move, undo, redo, copy, copy-text, save, exit, pin, recent",
  "tool_defaults": {"size": 3, "size_range": [1, 100]},
  "tools": [
    {"name": "pencil", "kind": "draw", "letter": "p", "symbol": "pencil",
     "tooltip": "Set the Pencil as the paint tool (P)"},
    {"name": "line", "kind": "draw", "letter": "d", "symbol": "line.diagonal",
     "tooltip": "Set the Line as the paint tool (D)"},
    {"name": "arrow", "kind": "draw", "letter": "a", "symbol": "arrow.down.left",
     "tooltip": "Set the Arrow as the paint tool (A)"},
    {"name": "selection", "kind": "draw", "letter": "s", "symbol": "square",
     "tooltip": "Set Selection as the paint tool (S)"},
    {"name": "rectangle", "kind": "draw", "letter": "r", "symbol": "square.fill",
     "tooltip": "Set the Rectangle as the paint tool (R)", "size": 1, "size_range": [0, 100]},
    {"name": "circle", "kind": "draw", "letter": "c", "symbol": "circle",
     "tooltip": "Set the Circle as the paint tool (C)"},
    {"name": "marker", "kind": "draw", "letter": "m", "symbol": "highlighter",
     "tooltip": "Set the Marker as the paint tool (M)", "size": 5},
    {"name": "text", "kind": "draw", "letter": "t", "symbol": "textformat",
     "tooltip": "Add text to your capture (T)", "size": 8},
    {"name": "counter", "kind": "draw", "symbol": "1.circle",
     "tooltip": "Add an autoincrementing counter bubble", "size": 1},
    {"name": "pixelate", "kind": "draw", "letter": "b", "symbol": "square.grid.3x3.fill",
     "tooltip": "Set Pixelate as the paint tool (B)", "size": 2},
    {"name": "invert", "kind": "draw", "letter": "i", "symbol": "circle.lefthalf.filled",
     "tooltip": "Set Inverter as the paint tool (I)"},
    {"name": "size", "kind": "info", "symbol": "",
     "tooltip": "Selection size"},
    {"name": "move", "kind": "mode", "symbol": "arrow.up.and.down.and.arrow.left.and.right",
     "tooltip": "Move the selection area (\u2318M)"},
    {"name": "undo", "kind": "action", "symbol": "arrow.uturn.backward",
     "tooltip": "Undo the last modification (\u2318Z)"},
    {"name": "redo", "kind": "action", "symbol": "arrow.uturn.forward",
     "tooltip": "Redo the next modification (\u21e7\u2318Z)"},
    {"name": "copy", "kind": "action", "symbol": "doc.on.doc", "finishes": true,
     "tooltip": "Copy selection to clipboard (\u2318C)"},
    {"name": "save", "kind": "action", "symbol": "square.and.arrow.down", "finishes": true,
     "tooltip": "Save screenshot to a file (\u2318S)"},
    {"name": "accept", "kind": "action", "symbol": "checkmark", "finishes": true,
     "tooltip": "Accept the capture (Return)"},
    {"name": "exit", "kind": "action", "symbol": "xmark", "finishes": true,
     "tooltip": "Leave the capture screen (\u2318Q)"},
    {"name": "pin", "kind": "action", "symbol": "pin.fill", "finishes": true,
     "tooltip": "Pin image on the desktop"},
    {"name": "recent", "kind": "action", "symbol": "clock",
     "tooltip": "Recent screenshots"},
    {"name": "copy-text", "kind": "action", "symbol": "text.viewfinder", "finishes": true,
     "tooltip": "Copy the text in the selection (\u21e7\u2318C)"},
    {"name": "size-increase", "kind": "action", "symbol": "plus",
     "tooltip": "Increase tool size"},
    {"name": "size-decrease", "kind": "action", "symbol": "minus",
     "tooltip": "Decrease tool size"}
  ]
}
