{
  "_comment": "Where kitchen-sink keeps its files. ONE source for python (jira_paths.py), the app (config.rs reads configDir; jira paths via the helper) and bin/check-overrides.sh. configDir = THE one folder for personal config: commands.toml override, pinned folders, jira/ (token + team), confluence/. Change it here (or WS_CONFIG_DIR). {configDir} expands in the values below. Env overrides: WS_CONFIG_DIR, JIRA_CONFIG_JSON, JIRA_TEAM_JSON, JIRA_CONFIG_FILE, JIRA_CACHE_DIR.",
  "configDir": "~/.config/kitchen-sink-local",
  "configJson": "{configDir}/jira/config.json",
  "teamJson": "{configDir}/jira/team.json",
  "legacyConfig": "{configDir}/jira/config",
  "confluenceConfig": "{configDir}/confluence/config.json",
  "cacheDir": "~/.cache/jira",
  "outDir": "~/.cache/kitchen-sink/jira_json",
  "cache": {
    "issues": "jiras.json",
    "status": "status.json",
    "directory": "directory.json",
    "boards": "boards.json",
    "boardCatalog": "board_catalog.json",
    "sprints": "sprints.json",
    "me": "me.json",
    "fieldsSeen": "fields_seen.json",
    "legacyPollState": "poll-state",
    "keysDir": "endpoints",
    "state": "state",
    "versions": "versions.json",
    "dumps": "dumps",
    "curlDump": "api_dump.txt",
    "trace": "api_trace.txt",
    "checkpoints": "checkpoints",
    "tz": "tz",
    "pageCap": "search_page_cap.json",
    "raw": "raw"
  },
  "tabs": {
    "liveSearch": "search.json",
    "favorites": "favorites.json",
    "blacklistRelease": "blacklist_release.json"
  },
  "sideDirs": {
    "releases": "jira_releases",
    "labels": "jira_labels",
    "boards": "jira_boards",
    "myWork": "jira_mywork"
  }
}
