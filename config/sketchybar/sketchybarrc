#!/usr/bin/env bash

source "$HOME/.config/sketchybar/colors.sh"
#source "$HOME/.config/sketchybar/icons.sh"

CONFIG_DIR="$HOME/.config/sketchybar"
ITEM_DIR="$HOME/.config/sketchybar/items"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

FONT="SF Pro"

PADDINGS=3

SHADOW=on

sketchybar --bar     height=34                                         \
                     color=$BAR_COLOR                                  \
                     shadow=$SHADOW                                    \
                     position=top                                       \
                     sticky=on                                         \
                     topmost=window                                        \
                     padding_right=12                                  \
                     padding_left=0                                    \
                      corner_radius=9                                   \
                      y_offset=4                                        \
                      margin=10                                         \
                     blur_radius=0                                     \
                                                                       \
           --default updates=when_shown                                \
                     icon.font="$FONT:Bold:14.0"                       \
                     icon.color=$ICON_COLOR                            \
                     icon.padding_left=$PADDINGS                       \
                     icon.padding_right=$PADDINGS                      \
                     label.font="$FONT:Semibold:13.0"                  \
                     label.color=$LABEL_COLOR                          \
                     label.padding_left=$PADDINGS                      \
                     label.padding_right=$PADDINGS                     \
                     background.padding_right=$PADDINGS                \
                     background.padding_left=$PADDINGS                 \
                     popup.background.border_width=2                   \
                     popup.background.corner_radius=11                 \
                     popup.background.border_color=$POPUP_BORDER_COLOR \
                     popup.background.color=$POPUP_BACKGROUND_COLOR    \
                     popup.background.shadow.drawing=$SHADOW

# Left
source "$PLUGIN_DIR/aerospacer.sh"

# Right
source "$PLUGIN_DIR/status.sh"
# Notification chips (left end of the status group; [notifications] in commands.toml)
source "$PLUGIN_DIR/notifications.sh"

# Guard: a monitor plug/unplug or wake can make AeroSpace invent workspace "10";
# this reverts it immediately (see the script header).
sketchybar --add item stray_guard left \
           --set stray_guard drawing=off updates=on \
                 script="$HOME/.config/workspace-switcher/bin/no_stray_workspaces.sh" \
           --subscribe stray_guard display_change system_woke

sketchybar --update

# Hide the bar while the auto-hidden native menu bar is revealed (hover at the
# top edge). Rebuilt only when the source changes; restarted on every reload.
MB_SRC="$CONFIG_DIR/helpers/menubar_watch.swift"
MB_BIN="$HOME/.cache/sketchybar/menubar_watch"
if [ ! -x "$MB_BIN" ] || [ "$MB_SRC" -nt "$MB_BIN" ]; then
    mkdir -p "${MB_BIN%/*}"
    swiftc -O "$MB_SRC" -o "$MB_BIN"
fi
pkill -x menubar_watch
"$MB_BIN" >/dev/null 2>&1 &
disown

echo "sketchybar configuation loaded.."
