<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.danielbaker.kitchen-sink.quick</string>
    <!-- Keeps the quick agent running from login on. It owns the Hyper+S /
         Hyper+X / Hyper+/ hotkeys itself (RegisterEventHotKey), so with no
         agent there are no hotkeys: KeepAlive restarts it when it exits.
         It goes through LaunchServices (`open`), never by exec'ing the binary
         from launchd: macOS then attributes Screen Recording and the other TCC
         grants to the app bundle. `open -W` waits for the app to exit, so
         launchd sees the agent's lifetime. `quick resident`: if another agent
         already holds the lock (say a build restarted one), this one waits
         for it to exit and takes over, instead of exiting into a respawn loop.
         __APP__ is replaced by bin/quick-agent.sh with the app bundle path. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-W</string>
        <string>-g</string>
        <string>-n</string>
        <string>__APP__</string>
        <string>--args</string>
        <string>quick</string>
        <string>resident</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
