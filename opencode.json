{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "external_directory": { "*": "allow" }
  },
  "mcp": {
    "servers": {
      "kitchen-sink": {
        "type": "local",
        "command": ["/Users/danielbaker/.config/kitchen-sink/bin/ks-mcp"],
        "environment": { "KS_MCP_READ_ONLY": "1" },
        "disabled": false
      },
      "kitchen-sink-sandbox": {
        "type": "local",
        "command": ["/Users/danielbaker/.config/kitchen-sink/bin/ks-mcp"],
        "environment": {
          "KS_SOCKET": "/Users/danielbaker/.config/kitchen-sink/.build/mcp-sandbox/tmp/ws-notes.sock"
        },
        "disabled": true
      }
    }
  }
}
